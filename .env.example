# ==============================================================================
# Environment Configuration Template (.env.example)
# Single Source of Truth for all configurable project parameters
# Conforms to Rule 8: Centralized Multi-Environment Parameter Management (Unified Single File)
# Copy this file to .env and configure with your specific credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED CORE CONFIGURATION (All Environments)
# ------------------------------------------------------------------------------
# Gemini API Key (Required when GOOGLE_GENAI_USE_VERTEXAI=FALSE)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SECRET_NAME=gemini-api-key:latest

# Backend Toggle: Set to FALSE to use Gemini API Key, TRUE for Vertex AI IAM/ADC
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Deployment Target: agent_runtime (Vertex AI Agent Engine / Gemini Enterprise Agent Platform)
AGENT_DEPLOYMENT_TARGET=agent_runtime

# Live Multimodal Audio Model
LIVE_API_MODEL=gemini-3.1-flash-live-preview
# Note: For Vertex AI mode (GOOGLE_GENAI_USE_VERTEXAI=TRUE), set LIVE_API_MODEL=gemini-live-2.5-flash-native-audio and GENAI_LOCATION=us-central1

# Live Voice Profiles per Agent (Gemini Prebuilt Voices: Aoede, Charon, Kore, Fenrir, Puck)
VOICE_ORCHESTRATOR=Aoede
VOICE_FLIGHT=Kore
VOICE_COMPLAINT=Charon

# Sampling Temperature (low temperature to avoid excessive imagination/hallucination)
AGENT_TEMPERATURE=0.2

# Google Cloud Project ID & Region (Singapore asia-southeast1 for Cloud Run Infra)
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=asia-southeast1
GENAI_LOCATION=us-central1
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Artifact Registry Repository Name
ARTIFACT_REGISTRY_REPO=cloudrun-app

# GitHub Repository URL
GITHUB_REPO=https://github.com/your-org/gemini-live-bot.git

# Service Health Probe Paths
HEALTH_CHECK_PATH=/healthz

# ------------------------------------------------------------------------------
# 2. NON-PRODUCTION CONFIGURATION (NONPROD_*)
# Used for active development, main branch CI/CD, and preview deployments
# ------------------------------------------------------------------------------
NONPROD_ENVIRONMENT_NAME=development
NONPROD_DEPLOYMENT_ID=gemini-live-bot-nonprod
NONPROD_AGENT_ENGINE_ID=pending
NONPROD_SERVICE_NAME=gemini-live-bot-nonprod
NONPROD_FRONTEND_SERVICE_NAME=gemini-live-bot-frontend-nonprod
NONPROD_BACKEND_SERVICE_NAME=gemini-live-bot-backend-nonprod
NONPROD_FRONTEND_IMAGE_NAME=gemini-live-bot-frontend
NONPROD_BACKEND_IMAGE_NAME=gemini-live-bot-backend
NONPROD_SERVICE_ACCOUNT_NAME=sa-gemini-live-bot-nonprod@your-gcp-project-id.iam.gserviceaccount.com
NONPROD_INFRA_MANAGER_SERVICE_ACCOUNT=sa-infra-mgr-nonprod@your-gcp-project-id.iam.gserviceaccount.com

# Resource Allocation & Scaling (Non-Prod scale to zero)
NONPROD_CPU=1
NONPROD_MEMORY=4Gi
NONPROD_CONCURRENCY=8
NONPROD_TIMEOUT=300
NONPROD_MIN_INSTANCES=0
NONPROD_MAX_INSTANCES=5

# ------------------------------------------------------------------------------
# 3. PRODUCTION CONFIGURATION (PROD_*)
# Used for stable releases, prod branch deployments, and customer traffic
# ------------------------------------------------------------------------------
PROD_ENVIRONMENT_NAME=production
PROD_DEPLOYMENT_ID=gemini-live-bot-prod
PROD_AGENT_ENGINE_ID=pending
PROD_SERVICE_NAME=gemini-live-bot-prod
PROD_FRONTEND_SERVICE_NAME=gemini-live-bot-frontend
PROD_BACKEND_SERVICE_NAME=gemini-live-bot-backend
PROD_FRONTEND_IMAGE_NAME=gemini-live-bot-frontend
PROD_BACKEND_IMAGE_NAME=gemini-live-bot-backend
PROD_SERVICE_ACCOUNT_NAME=sa-gemini-live-bot-prod@your-gcp-project-id.iam.gserviceaccount.com
PROD_INFRA_MANAGER_SERVICE_ACCOUNT=sa-infra-mgr-prod@your-gcp-project-id.iam.gserviceaccount.com

# Resource Allocation & Scaling (Prod warm instance min=1)
PROD_CPU=1
PROD_MEMORY=4Gi
PROD_CONCURRENCY=8
PROD_TIMEOUT=300
PROD_MIN_INSTANCES=1
PROD_MAX_INSTANCES=10
