# ==============================================================================
# Environment Configuration Template (.env.example)
# Single Source of Truth for all configurable project parameters
# Conforms to Rule 8: Centralized Multi-Environment Parameter Management (Unified Single File)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED CORE CONFIGURATION (All Environments)
# ------------------------------------------------------------------------------
# Google Cloud Project ID
GCP_PROJECT=prj-gc-npr-temai-rtai-01

# Deployment Region & AI Location
GCP_REGION=asia-southeast1
GENAI_LOCATION=global

# Default AI Model (Gemini Multimodal Live API / Gemini 2.0 / 3.7)
DEFAULT_MODEL=gemini-2.0-flash-exp
LIVE_API_MODEL=gemini-2.0-flash-exp

# Artifact Registry Repository Name
ARTIFACT_REGISTRY_REPO=cloudrun-app

# GitHub Repository URL
GITHUB_REPO=https://github.com/pantana-na/gemini-live-bot.git

# Service Ports & Health Probe Paths
PORT=8080
HEALTH_CHECK_PATH=/healthz

# ------------------------------------------------------------------------------
# 2. NON-PRODUCTION CONFIGURATION (NONPROD_*)
# Used for active development, main/develop branch CI/CD, and preview deployments
# ------------------------------------------------------------------------------
NONPROD_ENVIRONMENT_NAME=development
NONPROD_DEPLOYMENT_ID=gemini-live-bot-nonprod
NONPROD_FRONTEND_SERVICE_NAME=gemini-live-bot-frontend-nonprod
NONPROD_BACKEND_SERVICE_NAME=gemini-live-bot-backend-nonprod
NONPROD_FRONTEND_IMAGE_NAME=gemini-live-bot-frontend
NONPROD_BACKEND_IMAGE_NAME=gemini-live-bot-backend
NONPROD_SERVICE_ACCOUNT_NAME=svca-gc-npr-hxai-run-web@prj-gc-npr-temai-rtai-01.iam.gserviceaccount.com
NONPROD_INFRA_MANAGER_SERVICE_ACCOUNT=svca-gc-npr-hxai-build-iac@prj-gc-npr-temai-rtai-01.iam.gserviceaccount.com

# Resource Allocation & Scaling (Non-Prod scale to zero)
NONPROD_CPU=1
NONPROD_MEMORY=1Gi
NONPROD_CONCURRENCY=80
NONPROD_TIMEOUT=300
NONPROD_MIN_INSTANCES=0
NONPROD_MAX_INSTANCES=5

# ------------------------------------------------------------------------------
# 3. PRODUCTION CONFIGURATION (PROD_*)
# Used for stable releases, prod branch deployments, and customer traffic
# ------------------------------------------------------------------------------
PROD_ENVIRONMENT_NAME=production
PROD_DEPLOYMENT_ID=gemini-live-bot-prod
PROD_FRONTEND_SERVICE_NAME=gemini-live-bot-frontend
PROD_BACKEND_SERVICE_NAME=gemini-live-bot-backend
PROD_FRONTEND_IMAGE_NAME=gemini-live-bot-frontend
PROD_BACKEND_IMAGE_NAME=gemini-live-bot-backend
PROD_SERVICE_ACCOUNT_NAME=svca-gc-npr-hxai-run-web@prj-gc-npr-temai-rtai-01.iam.gserviceaccount.com
PROD_INFRA_MANAGER_SERVICE_ACCOUNT=svca-gc-npr-hxai-build-iac@prj-gc-npr-temai-rtai-01.iam.gserviceaccount.com

# Resource Allocation & Scaling (Prod warm instance min=1)
PROD_CPU=1
PROD_MEMORY=1Gi
PROD_CONCURRENCY=80
PROD_TIMEOUT=300
PROD_MIN_INSTANCES=1
PROD_MAX_INSTANCES=10
